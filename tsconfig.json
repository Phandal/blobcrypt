{
  "compilerOptions": {
    "lib": ["ES2023"],
    "skipLibCheck": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "resolveJsonModule": true,
    "rootDir": "src",
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true
  }
}
